public class Main
{
	public static void main(String[] args) {
	    int n=5;
	    straight(5);
	    inverse(5);
	}
	static void straight(int n){
	    for(int i=1;i<=n;i++){
	        for(int j=0;j<i;j++){
	            System.out.print("*");
	        }
	        System.out.println();
	    }
	}
	static void inverse(int n){
	    for(int i=n-1;i>0;i--){
	        for(int j=1;j<=i;j++){
	            System.out.print("*");
	        }
	        System.out.println();
	    }
	}
}

