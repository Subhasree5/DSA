public class Main
{
	public static void main(String[] args) {
	    int n=4;
	    straight(n);
	}
	static void straight(int n){
        for(int i=1;i<=n;i++){
            for(int j=1;j<=n-i;j++){
                System.out.print(" ");
            }
            for(int j=0;j<i;j++){
                System.out.print(i+" ");
            }
            for(int j=1;j<n-i;j++){
                System.out.print(" ");
            }
            System.out.println();
        }
	       
	}
}

