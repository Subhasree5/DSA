public class Main
{
	public static void main(String[] args) {
	    int n=5;
	    Pattern(5);
	}
	static void Pattern(int n){
	    for(int i=0;i<n;i++){
	        int breakpoint=(2*i+1)/2;
	        char ch='A';
	        for(int j=0;j<n-1-i;j++){
	            System.out.print(" ");
	        }
	        for(int j=1;j<=2*i+1;j++){
	            System.out.print(ch);
	            if(j<=breakpoint) ch++;
	            else ch--;
	        }
	        for(int j=0;j<n-1-i;j++){
	            System.out.print(" ");
	        }
	        System.out.println();
	    }     
	}
}

