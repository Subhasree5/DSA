public class Main
{
	public static void main(String[] args) {
	    int n=4;
	    straight(n);
	}
	static void straight(int n){
        for(int i=0;i<2*n-1;i++){
            for(int j=0;j<2*n-1;j++){
                int value=Math.max(Math.abs(i-(n-1)),Math.abs(j-(n-1)))+1;
                System.out.print(value);
            }
            System.out.println();
        }
	       
	}
}

