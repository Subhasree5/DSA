public class Main
{
	public static void main(String[] args) {
	    int n=4;
	    Pattern(4);
	}
	static void Pattern(int n){
	    int spaces=2*(n-1);
	    for(int i=1;i<=n;i++){
	        for(int j=1;j<=i;j++){
	            System.out.print(j);
	        }
	        for(int j=0;j<spaces;j++){
	            System.out.print(" ");
	        }
	        for(int j=i;j>0;j--){
	            System.out.print(j);
	        }
	        spaces-=2;
	        System.out.println();
	    }     
	}
}


