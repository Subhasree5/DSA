public class Main
{
	public static void main(String[] args) {
	    int n=5;
	    Pattern(5);
	}
	static void Pattern(int n){
	    for(int i=0;i<n;i++){
	        for(char ch=(char)('A'+n-1-i);ch<=(char)('A'+n-1);ch++){
	            System.out.print(ch);
	        }
	        System.out.println();
	    }     
	}
}

