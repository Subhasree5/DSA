public class Main
{
	public static void main(String[] args) {
	    int n=5;
	    Pattern(5);
	}
	static void Pattern(int n){
	    for(int i=0;i<n;i++){
	        char ch=(char)('A'+i);
	        for(int j=0;j<=i;j++){
	            System.out.print(ch);
	        }
	        System.out.println();
	    }     
	}
}

