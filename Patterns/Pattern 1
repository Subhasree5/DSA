public class Main
{
	public static void main(String[] args) {
	    int n=6;
	    pattern(6);
	}
	static void pattern(int n){
	    for(int i=0;i<n;i++){
	        for(int j=0;j<n;j++){
	            System.out.print("*");
	        }
	        System.out.println();
	    }
	}
}

