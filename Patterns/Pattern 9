public class Main
{
	public static void main(String[] args) {
	    int n=5;
	    straight(5);
	    inverse(5);
	}
	static void straight(int n){
	    for(int i=0;i<n;i++){
	        for(int j=0;j<n-i-1;j++){
	            System.out.print(" ");
	        }
	        for (int j=0;j<2*i+1;j++){
	            System.out.print("*");
	        }
	        for(int j=0;j<n-i-1;j++){
	            System.out.print(" ");
	        }
	        System.out.println();
	    }
	}
	static void inverse(int n){
	    for(int i=0;i<n;i++){
	        for(int j=0;j<i;j++){
	            System.out.print(" ");
	        }
	        for (int j=0;j<2*n-(2*i+1);j++){
	            System.out.print("*");
	        }
	        for(int j=0;j<i;j++){
	            System.out.print(" ");
	        }
	        System.out.println();
	    }
	}
}


